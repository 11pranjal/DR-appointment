PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/doctor_booking?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d

CLIENT_URL=http://localhost:5173

# Email (Gmail: use App Password — https://support.google.com/accounts/answer/185833)
